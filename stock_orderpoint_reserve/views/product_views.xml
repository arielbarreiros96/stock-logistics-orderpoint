<odoo>
    <!-- product.product's own form inherits this one, so one button serves both. -->
    <record id="product_template_form_view_reserve" model="ir.ui.view">
        <field name="name">product.template.form.orderpoint.reserve</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    name="action_open_orderpoint_reserves"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-lock"
                    groups="stock.group_stock_manager"
                    invisible="not is_storable"
                >
                    <field
                        name="orderpoint_reserve_count"
                        widget="statinfo"
                        string="Reserves"
                    />
                </button>
            </div>
        </field>
    </record>
</odoo>
