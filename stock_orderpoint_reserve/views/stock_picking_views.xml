<odoo>
    <record id="view_picking_form_orderpoint_reserve" model="ir.ui.view">
        <field name="name">stock.picking.form.orderpoint.reserve</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <button name="action_assign" position="after">
                <field name="orderpoint_reserve_guard" invisible="1" />
                <field name="orderpoint_reserve_released" invisible="1" />
                <button
                    name="action_ignore_orderpoint_reserve"
                    type="object"
                    string="Ignore Reserve"
                    groups="stock.group_stock_user"
                    invisible="not orderpoint_reserve_guard or state in ('draft', 'done', 'cancel')"
                    help="Let this replenishment reserve into the replenishment reserve of its source location, the way a transfer made by hand does. Applies to every transfer in the chain."
                />
                <button
                    name="action_respect_orderpoint_reserve"
                    type="object"
                    string="Respect Reserve"
                    groups="stock.group_stock_user"
                    invisible="not orderpoint_reserve_released or state in ('draft', 'done', 'cancel')"
                    help="Put this replenishment back under the reserve of its source location, handing back whatever it took above the floor. Applies to every transfer in the chain."
                />
            </button>
        </field>
    </record>

    <record id="view_move_tree_orderpoint_reserve" model="ir.ui.view">
        <field name="name">stock.move.list.orderpoint.reserve</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_tree" />
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field name="orderpoint_reserve_guard" optional="hide" />
            </field>
        </field>
    </record>
</odoo>
