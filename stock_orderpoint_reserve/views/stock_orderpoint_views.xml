<odoo>
    <record id="view_warehouse_orderpoint_tree_editable_reserve" model="ir.ui.view">
        <field name="name">stock.warehouse.orderpoint.list.reserve</field>
        <field name="model">stock.warehouse.orderpoint</field>
        <field name="inherit_id" ref="stock.view_warehouse_orderpoint_tree_editable" />
        <field name="arch" type="xml">
            <field name="qty_forecast" position="after">
                <field
                    name="qty_available_at_source"
                    optional="hide"
                    readonly="1"
                    width="60"
                />
            </field>
        </field>
    </record>

    <record id="view_warehouse_orderpoint_form_reserve" model="ir.ui.view">
        <field name="name">stock.warehouse.orderpoint.form.reserve</field>
        <field name="model">stock.warehouse.orderpoint</field>
        <field name="inherit_id" ref="stock.view_warehouse_orderpoint_form" />
        <field name="arch" type="xml">
            <field name="location_id" position="after">
                <field name="qty_available_at_source" readonly="1" />
            </field>
        </field>
    </record>
</odoo>
